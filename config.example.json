{
  "backends": {
    "llama-cpp": {
      "enabled": true,
      "base_url": "http://localhost:11433/v1",
      "api_key": "sk-no-key-required",
      "model_name": "qwen3-vl"
    },
    "qwen-vl": {
      "enabled": true,
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key": "your-dashscope-api-key",
      "model_name": "qwen-vl-flash"
    }
  },
  "default_backend": "llama-cpp",
  "cache_enabled": true,
  "llama": {
    "server_exe": "llama-server",
    "model": "请替换为视觉模型的绝对路径, 例如: D:\\llama\\Qwen3-VL-8B-Instruct-GGUF\\Qwen3VL-8B-Instruct-Q4_K_M.gguf",
    "mmproj": "请替换为图像编码器的绝对路径, 例如: D:\\llama\\Qwen3-VL-8B-Instruct-GGUF\\mmproj-Qwen3VL-8B-Instruct-F16.gguf",
    "host": "127.0.0.1",
    "port": 11433,
    "ngl": 99,
    "ctx_size": 8192,
    "predict": 16384,
    "temperature": 0.7,
    "top_k": 20,
    "top_p": 0.8,
    "repeat_penalty": 1.0,
    "presence_penalty": 1.5,
    "flash_attn": "auto",
    "cache_type_k": "f16",
